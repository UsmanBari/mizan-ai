# Copy to .env and fill in. NEVER commit .env.
# LLM: any OpenAI-compatible endpoint
MIZAN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MIZAN_LLM_API_KEY=your-gemini-key-from-aistudio.google.com
MIZAN_LLM_MODEL=gemini-3.5-flash
# USD per 1M tokens, used for cost reporting only (checked 22 Nov 2026)
# gemini-3.5-flash: 1.50 / 9.00     gemini-3.5-flash-lite: 0.30 / 2.50
MIZAN_PRICE_IN_PER_M=1.50
MIZAN_PRICE_OUT_PER_M=9.00
# Groq alternative:   MIZAN_LLM_BASE_URL=https://api.groq.com/openai/v1   MIZAN_LLM_MODEL=llama-3.3-70b-versatile
# Local model (extraction comparison): ollama pull qwen2.5:7b
MIZAN_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
MIZAN_LOCAL_LLM_MODEL=qwen2.5:7b
# Storage: "memory" for a quick demo, or postgres (docker compose sets this)
MIZAN_DATABASE_URL=memory
# Retrieval
MIZAN_EMBED_MODEL=BAAI/bge-small-en-v1.5
MIZAN_USE_RERANKER=true
# Integrations (optional)
MIZAN_TELEGRAM_BOT_TOKEN=
MIZAN_SMTP_USER=
MIZAN_SMTP_PASSWORD=
